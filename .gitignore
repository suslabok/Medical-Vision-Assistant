frontend/.env.production.local
frontend/.env.test.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================================
# Python / FastAPI (backend)
# =========================================
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd
backend/.env
backend/uploads/
backend/*.db
backend/test.db
.pytest_cache/

